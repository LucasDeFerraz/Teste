# parte4-laravel já tem seu próprio .gitignore (gerado pelo Laravel) cuidando
# de vendor/, node_modules/, .env, public/build, storage/*, etc. — incluindo
# os placeholders ".gitignore" que mantêm as pastas vazias no repositório.
# Duplicar essas regras aqui só arriscava sobrescrever esse comportamento
# (foi o que aconteceu com storage/framework/sessions/, que sumiu do repo).

# Arquivos de sistema
.DS_Store
Thumbs.db

# Compactados que já geramos (não precisam ir pro repositório)
*.rar
*.zip
